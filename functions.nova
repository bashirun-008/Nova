// Functions in NOVA
fn square(x) {
    return x * x;
}

fn greet(name) {
    print("Hello, " + name + "!");
}

fn fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

greet("NOVA");
print(square(7));
print(factorial(10));

let i = 0;
while (i < 10) {
    print(fib(i));
    i = i + 1;
}
